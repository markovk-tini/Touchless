{
  "name": "touchless-telemetry",
  "version": "1.0.0",
  "description": "Touchless anonymous-usage telemetry Worker (Cloudflare D1 backend).",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "deploy": "wrangler deploy",
    "schema": "wrangler d1 execute touchless-events --file=./schema.sql",
    "schema-remote": "wrangler d1 execute touchless-events --file=./schema.sql --remote"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20240909.0",
    "typescript": "^5.5.0",
    "wrangler": "^3.78.0"
  }
}
