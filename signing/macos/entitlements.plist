<?xml version="1.0" encoding="UTF-8"?>
<!--
  Touchless macOS hardened-runtime entitlements.

  NEW, SEPARATE from signing/sign-file.bat (Windows / Azure Trusted Signing).
  Used by builder/macos/build_mac.sh:
      codesign --options runtime --entitlements signing/macos/entitlements.plist ...

  Why each entitlement:
    - cs.allow-jit / allow-unsigned-executable-memory: CPython + Qt's V8
      (QtWebEngine) JIT and ctypes/dylib loading need writable+executable memory
      under the hardened runtime.
    - cs.disable-library-validation: PyInstaller loads many third-party .dylibs
      (numpy/opencv/mediapipe/onnxruntime/pyobjc, Qt frameworks) that are not all
      signed by our Team ID. Without this, dyld refuses to load them.
    - device.camera / device.audio-input: the gesture + voice pipelines.

  NOTE: Accessibility, Input Monitoring, and Screen Recording are TCC grants,
  not entitlements — they are requested at runtime, not declared here.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <key>com.apple.security.cs.allow-dyld-environment-variables</key>
    <true/>
    <key>com.apple.security.device.camera</key>
    <true/>
    <key>com.apple.security.device.audio-input</key>
    <true/>
    <key>com.apple.security.automation.apple-events</key>
    <true/>
</dict>
</plist>
