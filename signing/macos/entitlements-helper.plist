<?xml version="1.0" encoding="UTF-8"?>
<!--
  Entitlements for NESTED helper executables (e.g. QtWebEngineProcess.app's
  renderer/GPU helpers) inside Touchless.app.

  Apple's guidance: helper tools should NOT carry the parent app's privileged
  entitlements (camera, microphone, Apple Events). They get the minimum needed
  to run under the hardened runtime, plus `inherit` so they run inside the
  parent's sandbox/TCC context. Giving the WebEngine renderer the camera/
  apple-events entitlements is unnecessary privilege and a notarization smell.

  Used by builder/macos/build_mac.sh when signing *.app under Contents/Frameworks.
-->
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>com.apple.security.cs.allow-jit</key>
    <true/>
    <key>com.apple.security.cs.allow-unsigned-executable-memory</key>
    <true/>
    <key>com.apple.security.cs.disable-library-validation</key>
    <true/>
    <key>com.apple.security.inherit</key>
    <true/>
</dict>
</plist>
